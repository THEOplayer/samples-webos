{
  "name": "theo-reference-app",
  "version": "1.0.0",
  "description": "Theo WebOS Reference App",
  "scripts": {
    "bundle": "rollup -c ./rollup.config.js",
    "build": "npm run bundle && cp -R ./node_modules/@theoplayer/basic-hls-dash/ ./js/theoplayer",
    "copy-app": "cp -R js/ ./app/js && cp -R css/ ./app/css && cp index.html ./app/index.html",
    "package": "npm run build && npm run copy-app && ares-package  ./app --outdir ./",
    "watch": "rollup -c ./rollup.config.js --watch"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-typescript": "^4.1.1",
    "rollup": "^2.7.6",
    "tslib": "^1.11.1",
    "typescript": "^3.8.3"
  },
  "dependencies": {
    "@theoplayer/basic-hls-dash": "^8.8.2"
  }
}
